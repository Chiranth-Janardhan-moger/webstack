<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="add_bookmark"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_add"
        android:shortcutShortLabel="@string/shortcut_add_short"
        android:shortcutLongLabel="@string/shortcut_add_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.chiranth7.webstack"
            android:targetClass="com.example.MainActivity">
            <extra
                android:name="shortcut"
                android:value="add" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="search_bookmarks"
        android:enabled="true"
        android:icon="@drawable/ic_search"
        android:shortcutShortLabel="@string/shortcut_search_short"
        android:shortcutLongLabel="@string/shortcut_search_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.chiranth7.webstack"
            android:targetClass="com.example.MainActivity">
            <extra
                android:name="shortcut"
                android:value="search" />
        </intent>
    </shortcut>
</shortcuts>
